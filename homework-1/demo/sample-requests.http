@baseUrl = http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Task 1 + Task 2: Create Transactions (with validation)
# ─────────────────────────────────────────────────────────────

### Create a deposit
POST {{baseUrl}}/transactions
Content-Type: application/json

{
  "fromAccount": "ACC-EXTRL",
  "toAccount": "ACC-12345",
  "amount": 1000.00,
  "currency": "USD",
  "type": "deposit"
}

###

### Create a transfer
POST {{baseUrl}}/transactions
Content-Type: application/json

{
  "fromAccount": "ACC-12345",
  "toAccount": "ACC-67890",
  "amount": 250.50,
  "currency": "USD",
  "type": "transfer"
}

###

### Create a withdrawal
POST {{baseUrl}}/transactions
Content-Type: application/json

{
  "fromAccount": "ACC-67890",
  "toAccount": "ACC-EXTRL",
  "amount": 75.00,
  "currency": "EUR",
  "type": "withdrawal"
}

###

### Validation error: negative amount
POST {{baseUrl}}/transactions
Content-Type: application/json

{
  "fromAccount": "ACC-12345",
  "toAccount": "ACC-67890",
  "amount": -50,
  "currency": "USD",
  "type": "transfer"
}

###

### Validation error: bad account format + invalid currency
POST {{baseUrl}}/transactions
Content-Type: application/json

{
  "fromAccount": "12345",
  "toAccount": "ACC-67890",
  "amount": 100,
  "currency": "XYZ",
  "type": "transfer"
}

# ─────────────────────────────────────────────────────────────
# Task 1: List + Get
# ─────────────────────────────────────────────────────────────

###

### Get all transactions
GET {{baseUrl}}/transactions

###

### Get specific transaction by ID (replace with a real ID)
GET {{baseUrl}}/transactions/00000000-0000-0000-0000-000000000000

###

### 404 - transaction not found
GET {{baseUrl}}/transactions/nonexistent-id

# ─────────────────────────────────────────────────────────────
# Task 3: Filtering
# ─────────────────────────────────────────────────────────────

###

### Filter by accountId
GET {{baseUrl}}/transactions?accountId=ACC-12345

###

### Filter by type
GET {{baseUrl}}/transactions?type=transfer

###

### Filter by date range
GET {{baseUrl}}/transactions?from=2024-01-01&to=2024-12-31

###

### Combined filters
GET {{baseUrl}}/transactions?accountId=ACC-12345&type=transfer

# ─────────────────────────────────────────────────────────────
# Task 1: Account Balance
# ─────────────────────────────────────────────────────────────

###

### Get balance for ACC-12345
GET {{baseUrl}}/accounts/ACC-12345/balance

###

### Get balance for ACC-67890
GET {{baseUrl}}/accounts/ACC-67890/balance

# ─────────────────────────────────────────────────────────────
# Task 4-A: Account Summary
# ─────────────────────────────────────────────────────────────

###

### Get summary for ACC-12345
GET {{baseUrl}}/accounts/ACC-12345/summary

# ─────────────────────────────────────────────────────────────
# Task 4-B: Interest Calculation
# ─────────────────────────────────────────────────────────────

###

### Calculate 5% annual interest over 30 days for ACC-12345
GET {{baseUrl}}/accounts/ACC-12345/interest?rate=0.05&days=30

# ─────────────────────────────────────────────────────────────
# Task 4-C: CSV Export
# ─────────────────────────────────────────────────────────────

###

### Export all transactions as CSV
GET {{baseUrl}}/transactions/export?format=csv
